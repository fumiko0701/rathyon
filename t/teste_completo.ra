queijo idade = 20;
migalha limite = 18;
queijo resultado = 10 + 5 * 2;
queijo ativo = cheio;

farejar idade > limite {
    guinchar(idade);
} refarejar idade == limite {
    guinchar(limite);
} fujir {
    guinchar(resultado);
}

roer idade > 0 {
    idade = idade - 1;

    farejar idade == 5 {
        escapar;
    }
}

vasculhar item dentro trilha(3) {
    guinchar(item);
}

cavar somar(a, b) {
    voltar a + b;
}

queijo total = somar(10, 20);
guinchar(total);

ouvir jogador_entrou(nome) {
    guinchar(nome);
}

sinalizar jogador_entrou(42);

idade = 30;
farejar idade > 18 {
    guinchar(idade);
}
#tunel saida
guinchar("FIM DO PROGRAMA");
#toca

#tunel entrada
guinchar("INICIO DO PROGRAMA");
#toca

procure math;

queijo idade = 20;
migalha altura = 1.75;
barriga ativo = cheio;
chiado nome = "Rathyon";
ninho numeros = [1, 2, 3];

guinchar(idade);
guinchar(altura);
guinchar(ativo);
guinchar(nome);

farejar idade >= 18 {
    guinchar("maior de idade");
} refarejar idade == 17 {
    guinchar("quase maior");
} fujir {
    guinchar("menor de idade");
}

queijo contador = 0;
roer contador < 4 {
    contador = contador + 1;
    farejar contador == 2 {
        seguir;
    }
    guinchar(contador);
}

vasculhar item dentro trilha(3) {
    guinchar(item);
}

cavar queijo somar(queijo a, queijo b) {
    voltar a + b;
}

queijo total = somar(10, 20);
guinchar(total);
guinchar(math.sqrt(16));

numeros[1] = 20;
guinchar(numeros);

cace contador {
    presa 4 {
        guinchar("selecao: quatro");
    }
    fujir {
        guinchar("selecao: outro valor");
    }
}

ouvir jogador_entrou(jogador) {
    guinchar("Bem-vindo " + jogador);
}
sinalizar jogador_entrou("Visitante");

#tunel end
guinchar(99);
#toca

#tunel step
guinchar(10);

#tunel soma
cavar somar(a, b) {
    voltar a + b;
}
guinchar(somar(10, 20));
#toca

#tunel contagem
vasculhar i dentro trilha(3) {
    guinchar(i);
}
#toca

#tunel laco
queijo n = 5;
roer cheio {
    n = n - 1;
    farejar n == 2 {
        escapar;
    }
    guinchar(n);
}
guinchar(n);
#toca

#tunel condicional
migalha pi = 3.14;
farejar pi > 3 {
    guinchar(31);
} refarejar pi == 3 {
    guinchar(32);
} fujir {
    guinchar(33);
}
#toca

#tunel booleano
guinchar(cheio);
guinchar(vazio);
#toca

#tunel eventos
ouvir jogador_entrou(nome) {
    guinchar(nome);
}
sinalizar jogador_entrou(42);
#toca

#tunel repetida
contador = contador + 1;
guinchar(contador);
#toca

guinchar(20);
#vaparatunel repetida
guinchar(21);
#toca

#tunel start


guinchar(1);



queijo contador = 0;
#toca


